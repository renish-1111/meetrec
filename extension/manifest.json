{
  "manifest_version": 3,
  "name": "MeetRec",
  "version": "1.0.0",
  "description": "Automatically starts OBS recording when you join a Google Meet call and stops it shortly after you leave.",
  "permissions": ["storage", "scripting"],
  "host_permissions": ["https://meet.google.com/*", "http://127.0.0.1/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://meet.google.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
