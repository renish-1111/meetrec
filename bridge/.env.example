# OBS Tools > WebSocket Server Settings
OBS_WEBSOCKET_URL=ws://127.0.0.1:4455
OBS_WEBSOCKET_PASSWORD=

# Port this bridge listens on (must match BRIDGE_BASE_URL in extension/background.js)
PORT=17643

# Delay before starting recording after a Meet join is detected (must be <= 60)
START_DELAY_SECONDS=0

# Delay before stopping recording after the last Meet tab leaves. The extension
# takes ~1s to detect a hang-up, so 2 here = recording stops ~3s after you leave.
STOP_DELAY_SECONDS=2

# While in a call, each Meet tab checks in every 5s. A tab that's silent this
# long is treated as having left, so a lost "leave" can't keep OBS recording.
HEARTBEAT_TIMEOUT_SECONDS=15

# Command used to start OBS (minimized to tray) if it isn't running when a
# meeting starts. Leave empty to disable auto-launch.
OBS_LAUNCH_COMMAND=obs-studio --minimize-to-tray --disable-missing-files-check

# Google Drive upload (optional). Set these once from your Google Cloud OAuth
# client (Desktop app, see README). Then click "Connect Google Drive" in the
# MeetRec extension popup. Leave empty to turn uploading off.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Drive folder to upload into. It's created if it doesn't exist.
GOOGLE_DRIVE_FOLDER_NAME=MeetRec
# Delete the local recording after it uploads successfully.
DELETE_AFTER_UPLOAD=false
# Also upload recordings you start by hand in OBS, not just meeting recordings.
UPLOAD_MANUAL_RECORDINGS=false
